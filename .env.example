# Copy to .env. Never commit real credentials.
PORT=8787
HOST=127.0.0.1
APP_MODE=demo
DATA_DIR=./data
# Required when binding beyond localhost. Use a long random shared demo password.
APP_ACCESS_KEY=
# Exact browser origin; local Vite uses http://localhost:5173.
APP_ORIGIN=http://localhost:5173
# Set COOKIE_SECURE=true when deployed behind HTTPS.
COOKIE_SECURE=false

# Sandbox only. Production PayPal endpoints are intentionally not supported.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Choose demo (honest rule-based baseline), service (Waseem's HTTP endpoint),
# or llm (OpenAI-compatible chat-completions endpoint).
AI_PROVIDER=demo
AI_SERVICE_URL=http://127.0.0.1:8000/analyze
AI_SERVICE_TOKEN=
# Optional PDF/OCR service. Receives original file bytes as base64.
AI_EXTRACT_URL=
AI_CHAT_COMPLETIONS_URL=
AI_API_KEY=
AI_MODEL=
