{
  "name": "dispute-defender",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "node --import tsx --watch apps/api/src/index.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build --config apps/web/vite.config.ts",
    "start": "node --import tsx apps/api/src/index.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "eval": "node --import tsx scripts/evaluate.ts",
    "prestart": "node scripts/runtime-check.mjs",
    "predev": "node scripts/runtime-check.mjs",
    "doctor": "node scripts/runtime-check.mjs && node --import tsx scripts/doctor.ts",
    "paypal:check": "node scripts/runtime-check.mjs && node --import tsx scripts/paypal-check.ts"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "3.25.76",
    "tsx": "4.22.1"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "typescript": "5.9.3",
    "vite": "6.4.3"
  },
  "overrides": {
    "tsx": {
      "esbuild": "0.28.0"
    },
    "vite": {
      "esbuild": "0.25.12"
    },
    "rollup": "4.62.2"
  }
}
